import os
from flask import Flask, jsonify, render_template, request

from foodai.nutrition import NUTRITION_DATABASE, get_nutrition_info

app = Flask(__name__)


@app.route("/")
def index():
    return render_template("index.html")


@app.route("/api/nutrition/lookup", methods=["GET", "POST"])
def nutrition_lookup():
    food_query = ""
    if request.method == "POST":
        data = request.get_json() or {}
        food_query = data.get("food", "")
    else:
        food_query = request.args.get("food", "")

    if not food_query:
        return jsonify({"error": "Food query parameter missing"}), 400

    info = get_nutrition_info(food_query)
    return jsonify({
        "status": "success",
        "food": food_query,
        "nutrition": info
    })


@app.route("/api/nutrition/database", methods=["GET"])
def nutrition_database():
    return jsonify({
        "status": "success",
        "total_items": len(NUTRITION_DATABASE),
        "items": NUTRITION_DATABASE
    })


if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000)