import base64
import os
from flask import Flask, jsonify, render_template, request

from foodai.nutrition import get_nutrition_info
from foodai.recognizer import recognize_food
from foodai.utils import process_and_compress_image

app = Flask(__name__)


@app.route("/")
def index():
    return render_template("index.html")


@app.route("/api/health", methods=["GET"])
def health():
    return jsonify({"status": "ok", "module": "camera_pipeline_v1"})


@app.route("/api/recognize", methods=["POST"])
def recognize():
    image_bytes = None

    if request.is_json:
        data = request.get_json()
        raw_img = data.get("image", "")
        if "," in raw_img:
            raw_img = raw_img.split(",")[1]
        try:
            image_bytes = base64.b64decode(raw_img)
        except Exception as err:
            return jsonify({"error": f"Base64 parse error: {str(err)}"}), 400
    elif "image" in request.files:
        image_bytes = request.files["image"].read()

    if not image_bytes:
        return jsonify({"error": "Missing video frame image"}), 400

    # Optimize raw frame before feeding vision AI
    optimized_bytes = process_and_compress_image(image_bytes, max_size=(800, 800), quality=80)

    try:
        res = recognize_food(optimized_bytes)
        nut = get_nutrition_info(res.get("food", ""))
        return jsonify({
            "status": "success",
            "food": res.get("food", "Unknown Food"),
            "confidence": res.get("confidence", "88%"),
            "cuisine": res.get("cuisine", "General"),
            "nutrition": nut
        })
    except Exception as e:
        return jsonify({"error": str(e)}), 500


if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000)