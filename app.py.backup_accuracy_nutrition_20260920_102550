import base64
import os
from flask import Flask, jsonify, render_template, request

from foodai.nutrition import get_nutrition_info
from foodai.recognizer import recognize_food
from foodai.restaurants import get_nearby_restaurants
from foodai.telegram import send_telegram_notification

app = Flask(__name__, template_folder="templates", static_folder="static")


@app.route("/")
def index():
    return render_template("index.html")


@app.route("/api/health", methods=["GET"])
def health():
    return jsonify({
        "status": "ok",
        "mode": "accuracy_nutrition",
        "message": "FoodAI High-Precision Nutrition Backend Running"
    })


@app.route("/api/recognize", methods=["POST"])
def recognize():
    image_bytes = None

    if "image" in request.files:
        image_bytes = request.files["image"].read()
    elif request.is_json:
        data = request.get_json()
        img_str = data.get("image", "")
        if "," in img_str:
            img_str = img_str.split(",")[1]
        try:
            image_bytes = base64.b64decode(img_str)
        except Exception:
            return jsonify({"error": "Invalid base64 encoding"}), 400

    if not image_bytes:
        return jsonify({"error": "No image payload supplied"}), 400

    try:
        rec_data = recognize_food(image_bytes)
        dish_name = rec_data.get("food", "Unknown Food")
        confidence = rec_data.get("confidence", "95%")
        cuisine = rec_data.get("cuisine", "International")

        # Precision nutrition lookup
        nutrition_data = get_nutrition_info(dish_name)

        return jsonify({
            "status": "success",
            "food": dish_name,
            "confidence": confidence,
            "cuisine": cuisine,
            "nutrition": nutrition_data
        })
    except Exception as e:
        return jsonify({"error": f"Accuracy processing failed: {str(e)}"}), 500


@app.route("/api/restaurants", methods=["POST"])
def restaurants():
    data = request.get_json() or {}
    lat = data.get("latitude")
    lng = data.get("longitude")

    if lat is None or lng is None:
        return jsonify({"error": "Latitude and Longitude required"}), 400

    result = get_nearby_restaurants(float(lat), float(lng), radius_meters=15000)
    return jsonify(result)


@app.route("/api/notify", methods=["POST"])
def notify():
    data = request.get_json() or {}
    success = send_telegram_notification(data)
    if success:
        return jsonify({"status": "success", "message": "Notification dispatched"})
    return jsonify({"status": "error", "message": "Telegram send failure"}), 500


if __name__ == "__main__":
    port = int(os.getenv("PORT", 5000))
    app.run(host="0.0.0.0", port=port, debug=True)