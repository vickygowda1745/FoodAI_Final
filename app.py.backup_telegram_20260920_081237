import os
from flask import Flask, jsonify, render_template, request

from foodai.telegram import format_telegram_message, send_telegram_notification

app = Flask(__name__)


@app.route("/")
def index():
    return render_template("index.html")


@app.route("/api/notify", methods=["POST"])
def telegram_notify():
    payload = request.get_json()
    if not payload:
        return jsonify({"error": "JSON body missing"}), 400

    # Ensure defaults exist
    data = {
        "food": payload.get("food", "Chicken Biryani"),
        "confidence": payload.get("confidence", "95%"),
        "cuisine": payload.get("cuisine", "Indian"),
        "nutrition": payload.get("nutrition", {
            "calories": "520",
            "protein": "28",
            "carbs": "64",
            "fat": "16",
            "fiber": "3.5"
        }),
        "timestamp": payload.get("timestamp", "Sep 20, 2026, 02:47 PM"),
        "latitude": payload.get("latitude"),
        "longitude": payload.get("longitude")
    }

    formatted_msg = format_telegram_message(data)
    success = send_telegram_notification(data)

    if success:
        return jsonify({
            "status": "success",
            "message": "Telegram scan notification dispatched successfully",
            "preview": formatted_msg
        })

    return jsonify({
        "status": "error",
        "message": "Failed to post message to Telegram API"
    }), 500


if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000)